func void bubble(int[] data, int size) {
    int i = 0;
    while (i < size) {
        int j = 0;
        while (j < size - i - 1) {
            if (data[j] > data[j + 1]) {
                int tmp = data[j];
                data[j] = data[j + 1];
                data[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

int[] values = [64, 34, 25, 12, 22, 11, 90];
bubble(values, 7);
int k = 0;
while (k < 7) {
    print(values[k]);
    k = k + 1;
}
