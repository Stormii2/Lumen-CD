func int steps(int start) {
    int n = start;
    int count = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count = count + 1;
    }
    return count;
}

int best = 0;
int arg = 1;
int i = 1;
while (i < 30) {
    int s = steps(i);
    if (s > best) {
        best = s;
        arg = i;
    }
    i = i + 1;
}
print(arg);
print(best);
