func bool isPrime(int n) {
    if (n < 2) {
        return false;
    }
    int d = 2;
    while (d * d <= n) {
        if (n % d == 0) {
            return false;
        }
        d = d + 1;
    }
    return true;
}

int count = 0;
int n = 2;
while (n < 50) {
    if (isPrime(n)) {
        count = count + 1;
        print(n);
    }
    n = n + 1;
}
print(count);
